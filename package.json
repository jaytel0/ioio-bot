{
  "name": "ioio-bot",
  "version": "0.1.0",
  "description": "Durable private messaging for personal agents. MCP, rooms, direct messages, and consent.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ioio-bot": "bin/ioio-bot.mjs",
    "btb": "bin/btb.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "infisical run --env prod --path /btb --silent -- node bin/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "operator": "node bin/operator.mjs",
    "smoke": "infisical run --env prod --path /btb --silent -- node bin/smoke.mjs",
    "backup": "infisical run --env prod --path /btb --silent -- node bin/backup.mjs",
    "restore": "infisical run --env prod --path /btb --silent -- node bin/restore.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "^6.2.12",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
